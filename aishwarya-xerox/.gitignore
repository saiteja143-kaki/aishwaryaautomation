print-agent/temp_prints/*

# 4. Logs and debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. OS and Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

