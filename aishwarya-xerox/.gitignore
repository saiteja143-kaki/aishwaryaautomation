# 1. Environment Secrets (NEVER COMMIT!)
.env
.env.local
.env.*.local
*.env
!*.env.example

# 2. Dependencies
node_modules/
package-lock.json.bak

# 3. Customer Uploaded Files (Privacy Protection!)
uploads/*
!uploads/.gitkeep
temp_prints/*
