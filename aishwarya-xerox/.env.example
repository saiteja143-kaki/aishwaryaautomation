# Aishwarya Xerox - Environment Variables
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000

# ==========================================
# PhonePe Payment Gateway Credentials
# (Copy from your aishwaryaprinthub PhonePe Dashboard)
# ==========================================
PHONEPE_ENV=PROD
PHONEPE_MERCHANT_ID=YOUR_PRODUCTION_MERCHANT_ID
PHONEPE_SALT_KEY=your_production_salt_key_here
PHONEPE_SALT_INDEX=1

# Canon Printer Name (on Shop PC)
PRINTER_NAME=Canon_imageRUNNER

